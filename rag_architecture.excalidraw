      "versionNonce": 1461322283,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789441503427,
      "link": null,
      "locked": false,
      "text": "Deployed on Google Cloud Run \u2014 rag-api + rag-ui services \u00b7 secrets in Secret Manager \u00b7 image in Artifact Registry\nCI/CD via GitHub Actions + Workload Identity Federation (no stored keys) \u00b7 same stateless design also documented for AWS ECS Fargate",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 13,
      "containerId": null,
      "originalText": "Deployed on Google Cloud Run \u2014 rag-api + rag-ui services \u00b7 secrets in Secret Manager \u00b7 image in Artifact Registry\nCI/CD via GitHub Actions + Workload Identity Federation (no stored keys) \u00b7 same stateless design also documented for AWS ECS Fargate",
      "lineHeight": 1.25
    }
  ],
